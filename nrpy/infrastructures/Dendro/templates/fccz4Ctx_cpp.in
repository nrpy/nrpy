void swap_vectors(mock::DVector& a, mock::DVector& b) {
  DendroScalar** tmp_comp = a.comp;
  unsigned tmp_b = a.num_blocks;
  unsigned tmp_c = a.num_components;
  a.comp = b.comp;
  a.num_blocks = b.num_blocks;
  a.num_components = b.num_components;
  b.comp = tmp_comp;
  b.num_blocks = tmp_b;
  b.num_components = tmp_c;
}

void free_vector(mock::DVector& vec) {
  if (vec.comp == nullptr) return;
  for (unsigned f = 0; f < vec.num_components; ++f) delete[] vec.comp[f];
  delete[] vec.comp;
  vec.comp = nullptr;
}

}  // namespace

Ctx::~Ctx() {
  free_vector(host.in);
  free_vector(host.rhs);
  free_vector(host.out);
  free_vector(host.diag);
  if (u0 != nullptr) {
    for (unsigned f = 0; f < fccz4::generated::NUM_EVOL_GFS; ++f) delete[] u0[f];
    delete[] u0;
    u0 = nullptr;
  }
}

int Ctx::initialize_world(int n_blocks, int extent, double dx, int rank,
                          const char* toml_path) {
  const int pad = static_cast<int>(fccz4::generated::REQUIRED_PADDING);
  if (n_blocks < 1 || n_blocks > static_cast<int>(mock::MAX_MOCK_BLOCKS) ||
      extent < 2 * pad + 1) {
    std::fprintf(stderr,
                 "ERROR: mock world needs 1..%d blocks and extent >= "
                 "2*padding+1 (%d); got n_blocks=%d extent=%d\n",
                 static_cast<int>(mock::MAX_MOCK_BLOCKS), 2 * pad + 1,
                 n_blocks, extent);
    return 1;
  }
  host.world.num_blocks = static_cast<unsigned>(n_blocks);
  // Each rank owns a disjoint physical subdomain: rank r starts where rank
  // r-1's blocks end.  Without this every rank would evolve an identical
  // private copy and a multi-rank run would prove nothing beyond a repeated
  // serial run (section 16.8 rank agreement).
  const double rank_origin =
      static_cast<double>(rank) * static_cast<double>(n_blocks) * extent * dx;
  for (int b = 0; b < n_blocks; ++b) {
    BlockGeometry& g = host.world.geom[b];
    g.nx = g.ny = g.nz = static_cast<unsigned>(extent);
    g.padding = static_cast<unsigned>(pad);
    g.component_offset =
        static_cast<std::size_t>(b) * extent * extent * extent;
    g.pmin_padded[0] = rank_origin + static_cast<double>(b) * extent * dx;
    g.pmin_padded[1] = 0.0;
    g.pmin_padded[2] = 0.0;
    g.dx[0] = g.dx[1] = g.dx[2] = dx;
    g.boundary_flags = 0;
  }
  const unsigned ncomp = fccz4::generated::NUM_EVOL_GFS;
  const std::size_t vol = static_cast<std::size_t>(extent) * extent * extent;
  mock::DVector* vectors[] = {&host.in, &host.rhs, &host.out, &host.diag};
  // The diagnostic vector carries the generated DIAG count, which is a
  // different cardinality from the evolved vectors (section 14.6).
  const unsigned counts[] = {ncomp, ncomp, ncomp,
                             fccz4::generated::NUM_DIAG_GFS};
  for (unsigned v = 0; v < sizeof(vectors) / sizeof(vectors[0]); ++v) {
    mock::DVector* vec = vectors[v];
    vec->num_blocks = static_cast<unsigned>(n_blocks);
    vec->num_components = counts[v];
    vec->comp = new DendroScalar*[counts[v]];
    for (unsigned f = 0; f < counts[v]; ++f) {
      vec->comp[f] =
          new DendroScalar[static_cast<std::size_t>(n_blocks) * vol];
      std::memset(vec->comp[f], 0,
                  sizeof(DendroScalar) * static_cast<std::size_t>(n_blocks) * vol);
    }
  }
  // Section 6.4: the registered parameter CFunctions own the parameter
  // lifecycle (defaults, TOML binding, validation, print).
  fccz4_params_set_defaults(fccz4_params);
  if (toml_path != nullptr) {
    if (fccz4_params_parse_toml(fccz4_params, toml_path) != 0) {
      std::fprintf(stderr,
                   "ERROR: a parameter file was supplied (%s) but this "
                   "generated profile has no TOML binding, so its values "
                   "would be silently ignored.  Rerun without -t, or "
                   "regenerate once the parser lands (section 6.4).\n",
                   toml_path);
      return 1;
    }
  }
  return 0;
}

int Ctx::startup_checks() {
  // Section 13.7 runtime startup checks (mock vehicle): the compiled module
  // ABI constants are present and the generated scalar/state/padding/FD
  // contracts hold for every local block and vector.
  const char* abi = fccz4::generated::MODULE_ABI_HASH;
  if (std::strlen(abi) != 64) {
    std::fprintf(stderr, "ERROR: module ABI hash is not a SHA-256 digest\n");
    return 1;
  }
  if (host.in.num_components != fccz4::generated::NUM_EVOL_GFS ||
      host.rhs.num_components != fccz4::generated::NUM_EVOL_GFS ||
      host.out.num_components != fccz4::generated::NUM_EVOL_GFS ||
      host.diag.num_components != fccz4::generated::NUM_DIAG_GFS) {
    std::fprintf(stderr, "ERROR: vector component count mismatch\n");
    return 1;
  }
  for (unsigned b = 0; b < host.world.num_blocks; ++b) {
    if (host.world.geom[b].padding < fccz4::generated::REQUIRED_PADDING) {
      std::fprintf(stderr, "ERROR: block %u padding below generated minimum\n", b);
      return 1;
    }
  }
  const unsigned fd_order = fccz4::generated::FD_ORDER;
  if (fd_order != 2 && fd_order != 4 && fd_order != 6 && fd_order != 8) {
    std::fprintf(stderr, "ERROR: unsupported generated FD order %u\n", fd_order);
    return 1;
  }
  if (!fccz4_params_validate(fccz4_params)) {
    std::fprintf(stderr, "ERROR: fccz4 parameter validation failed\n");
    return 1;
  }
  // Section 13.7: print the semantic hashes.
  std::printf("fccz4 module_abi_hash        = %s\n", abi);
  std::printf("fccz4 state_schema_hash      = %s\n", fccz4::generated::STATE_SCHEMA_HASH);
  std::printf("fccz4 parameter_schema_hash  = %s\n", fccz4::generated::PARAMETER_SCHEMA_HASH);
  std::printf("fccz4 equation_hash          = %s\n", fccz4::generated::EQUATION_HASH);
  std::printf("fccz4 stencil_hash           = %s\n", fccz4::generated::STENCIL_HASH);
  std::printf("fccz4 cfunction_api_hash     = %s\n", fccz4::generated::CFUNCTION_API_HASH);
  std::printf("fccz4 cfunction_source_hash  = %s\n", fccz4::generated::CFUNCTION_SOURCE_HASH);
  fccz4_params_print_effective(fccz4_params);
  return 0;
}

int Ctx::minkowski_initial_data() {
  fccz4_minkowski_initial_data(host.world, host.in.comp);
  return 0;
}

int Ctx::perturb_state(double amplitude, double wavelength) {
  // The analytic profile and the loop that applies it are NRPy-authored and
  // registered (section 9.16); the host only supplies the state and the two
  // scalars.
  fccz4_smooth_perturbation(host.world, host.in.comp,
                            static_cast<DendroScalar>(amplitude),
                            static_cast<DendroScalar>(wavelength));
  return 0;
}

int Ctx::rhs_all_blocks() {
  fccz4_rhs(host.world, host.in.comp, host.rhs.comp$RHS_CPARAM_TAIL);
  return 0;
}

double Ctx::max_interior_rhs() {
  rhs_all_blocks();
  return max_interior_value(host.rhs.comp, fccz4::generated::NUM_EVOL_GFS);
}

double Ctx::flat_adapter_max_difference() {
  // Section 13.6: the LTS flat-block adapter must invoke the same numerical
  // body as the per-block entry point.  Evaluate both on this rank's first
  // block and compare pointwise.
  const unsigned ncomp = fccz4::generated::NUM_EVOL_GFS;
  const BlockGeometry& g = host.world.geom[0];
  const std::size_t vol =
      static_cast<std::size_t>(g.nx) * g.ny * g.nz;
  std::vector<DendroScalar> flat_in(static_cast<std::size_t>(ncomp) * vol, 0.0);
  std::vector<DendroScalar> flat_rhs(static_cast<std::size_t>(ncomp) * vol, 0.0);
  for (unsigned f = 0; f < ncomp; ++f) {
    std::memcpy(&flat_in[static_cast<std::size_t>(f) * vol],
                host.in.comp[f] + g.component_offset,
                sizeof(DendroScalar) * vol);
  }
  BlockGeometry flat_geom = g;
  flat_geom.component_offset = 0;
  fccz4_rhs_flat_block(flat_geom, flat_in.data(), flat_rhs.data()$RHS_CPARAM_TAIL);
  std::vector<const DendroScalar*> block_in(ncomp);
  std::vector<DendroScalar*> block_rhs(ncomp);
  std::vector<std::vector<DendroScalar>> storage(
      ncomp, std::vector<DendroScalar>(vol, 0.0));
  for (unsigned f = 0; f < ncomp; ++f) {
    block_in[f] = host.in.comp[f] + g.component_offset;
    block_rhs[f] = storage[f].data();
  }
  fccz4_rhs_block(flat_geom, block_in.data(), block_rhs.data()$RHS_CPARAM_TAIL);
  double worst = 0.0;
  for (unsigned f = 0; f < ncomp; ++f) {
    for (unsigned bz = g.padding; bz < g.nz - g.padding; ++bz) {
      for (unsigned by = g.padding; by < g.ny - g.padding; ++by) {
        for (unsigned bx = g.padding; bx < g.nx - g.padding; ++bx) {
          const std::size_t cell = bx + g.nx * (by + g.ny * bz);
          const double d = std::fabs(
              static_cast<double>(block_rhs[f][cell]) -
              static_cast<double>(flat_rhs[static_cast<std::size_t>(f) * vol + cell]));
          if (d > worst) worst = d;
        }
      }
    }
  }
  return worst;
}

int Ctx::euler_step(double dt) {
  rhs_all_blocks();
  // Host integrator (Dendro-owned lifecycle): u_out = u_in + dt * rhs.  No
  // formulation content here: every derivative and equation term was
  // computed by the registered generated CFunctions.
  const unsigned ncomp = fccz4::generated::NUM_EVOL_GFS;
  const unsigned nb = host.in.num_blocks;
  const unsigned extent = host.world.geom[0].nx;
  const std::size_t vol = static_cast<std::size_t>(extent) * extent * extent;
  const std::size_t total = static_cast<std::size_t>(nb) * vol;
  for (unsigned f = 0; f < ncomp; ++f) {
    const DendroScalar* u = host.in.comp[f];
    const DendroScalar* f_rhs = host.rhs.comp[f];
    DendroScalar* u_new = host.out.comp[f];
    for (std::size_t cell = 0; cell < total; ++cell) {
      u_new[cell] = u[cell] + static_cast<DendroScalar>(dt) * f_rhs[cell];
    }
  }
  swap_vectors(host.in, host.out);
  return 0;
}

double Ctx::max_interior_value(const DendroScalar* const* fields,
                              unsigned ncomp) {
  double worst = 0.0;
  for (unsigned b = 0; b < host.world.num_blocks; ++b) {
    const BlockGeometry& g = host.world.geom[b];
    const std::size_t base = g.component_offset;
    for (unsigned f = 0; f < ncomp; ++f) {
      const DendroScalar* v = fields[f];
      for (unsigned bz = g.padding; bz < g.nz - g.padding; ++bz) {
        for (unsigned by = g.padding; by < g.ny - g.padding; ++by) {
          for (unsigned bx = g.padding; bx < g.nx - g.padding; ++bx) {
            const double a = std::fabs(static_cast<double>(
                v[base + bx + g.nx * (by + g.ny * bz)]));
            if (a > worst) worst = a;
          }
        }
      }
    }
  }
  return worst;
}

int Ctx::snapshot_state() {
  const unsigned ncomp = fccz4::generated::NUM_EVOL_GFS;
  const unsigned nb = host.in.num_blocks;
  const unsigned extent = host.world.geom[0].nx;
  const std::size_t total = static_cast<std::size_t>(nb) * extent * extent * extent;
  if (u0 != nullptr) {
    for (unsigned f = 0; f < ncomp; ++f) delete[] u0[f];
    delete[] u0;
    u0 = nullptr;
  }
  u0 = new DendroScalar*[ncomp];
  for (unsigned f = 0; f < ncomp; ++f) {
    u0[f] = new DendroScalar[total];
    std::memcpy(u0[f], host.in.comp[f], sizeof(DendroScalar) * total);
  }
  return 0;
}

double Ctx::max_drift_from_snapshot() {
  const unsigned ncomp = fccz4::generated::NUM_EVOL_GFS;
  const unsigned nb = host.in.num_blocks;
  const unsigned extent = host.world.geom[0].nx;
  const std::size_t total =
      static_cast<std::size_t>(nb) * extent * extent * extent;
  double worst = 0.0;
  for (unsigned f = 0; f < ncomp; ++f) {
    for (std::size_t cell = 0; cell < total; ++cell) {
      const double d = std::fabs(static_cast<double>(host.in.comp[f][cell]) -
                                 static_cast<double>(u0[f][cell]));
      if (d > worst) worst = d;
    }
  }
  return worst;
}

int Ctx::project_state() {
  // Section 14.5: the projection is scheduled after initial-data construction
  // and after every accepted timestep.  The generated kernel never calls
  // exit(); it reports a structured status, and the host decides.
  last_projection = fccz4::generated::ProjectionStatus{};
  fccz4_project(host.world, host.in.comp, &last_projection);
  ++projection_passes;
  if (fccz4::generated::projection_failed(last_projection)) {
    std::fprintf(stderr,
                 "ERROR: projection refused %llu point(s); first at index "
                 "%lld, first nonfinite field index %d\n",
                 last_projection.failed_points,
                 last_projection.first_failing_index,
                 last_projection.first_failing_field);
    return 1;
  }  // END IF: projection refused a point
  return 0;
}  // END FUNCTION: Ctx::project_state

double Ctx::max_constraint_violation() {
  // Recompute the diagnostics from the current evolved state and reduce over
  // every generated DIAG component.  No diagnostic is named here: the count
  // and the ordering are generated (section 9.16).
  fccz4_constraints(host.world, host.in.comp, host.diag.comp);
  return max_interior_value(host.diag.comp, fccz4::generated::NUM_DIAG_GFS);
}  // END FUNCTION: Ctx::max_constraint_violation

int Ctx::select_variables(const char* const* names, unsigned count) {
  // Section 14.7: VTU output and refinement candidates are selected by exact
  // NRPy name.  Matching is case-sensitive, and an unknown name is fatal.
  int rc = 0;
  for (unsigned k = 0; k < count; ++k) {
    const std::optional<fccz4::generated::VariableRef> ref =
        fccz4::generated::find_variable(names[k]);
    if (!ref.has_value()) {
      std::fprintf(stderr, "ERROR: unknown variable name '%s'\n", names[k]);
      rc = 1;
      continue;
    }  // END IF: name did not resolve
    std::printf("SELECTED %s group=%u index=%u\n", names[k],
                static_cast<unsigned>(ref->group), ref->index);
  }  // END LOOP: for k over selected names
  if (rc != 0) {
    std::fprintf(stderr, "Valid generated variable names:\n");
    for (const fccz4::generated::VariableRef::Group group :
         fccz4::generated::VARIABLE_GROUPS) {
      const unsigned n = fccz4::generated::variable_count(group);
      for (unsigned index = 0; index < n; ++index) {
        const std::string_view name =
            fccz4::generated::variable_name(group, index);
        std::fprintf(stderr, "  %.*s\n", static_cast<int>(name.size()),
                     name.data());
      }  // END LOOP: for index over group names
    }  // END LOOP: for group over generated groups
  }  // END IF: an unknown name was supplied
  return rc;
}  // END FUNCTION: Ctx::select_variables

namespace {

// Evaluate the generated RHS on one block of the given resolution, filled with
// the same continuum profile, and return the interior values sampled at the
// coincident physical point (the block centre) for every component.
void sample_rhs_at_centre(int extent, double dx, int sample_index,
                          double amplitude, double wavelength,
                          const fccz4::generated::GeneratedParams& params,
                          std::vector<double>& out) {
  const unsigned ncomp = fccz4::generated::NUM_EVOL_GFS;
  const std::size_t vol = static_cast<std::size_t>(extent) * extent * extent;
  std::vector<std::vector<DendroScalar>> state(
      ncomp, std::vector<DendroScalar>(vol, 0.0));  // NOLINT
  std::vector<std::vector<DendroScalar>> rhs(
      ncomp, std::vector<DendroScalar>(vol, 0.0));
  BlockGeometry g;
  g.nx = g.ny = g.nz = static_cast<unsigned>(extent);
  g.padding = fccz4::generated::REQUIRED_PADDING;
  g.component_offset = 0;
  g.pmin_padded[0] = g.pmin_padded[1] = g.pmin_padded[2] = 0.0;
  g.dx[0] = g.dx[1] = g.dx[2] = dx;
  g.boundary_flags = 0;
  std::vector<DendroScalar*> state_ptr(ncomp);
  std::vector<const DendroScalar*> state_cptr(ncomp);
  std::vector<DendroScalar*> rhs_ptr(ncomp);
  for (unsigned f = 0; f < ncomp; ++f) {
    state_ptr[f] = state[f].data();
    state_cptr[f] = state[f].data();
    rhs_ptr[f] = rhs[f].data();
  }
  fccz4_minkowski_initial_data_block(g, state_ptr.data());
  fccz4_smooth_perturbation_block(g, state_ptr.data(),
                                  static_cast<DendroScalar>(amplitude),
                                  static_cast<DendroScalar>(wavelength));
  fccz4_rhs_block(g, state_cptr.data(), rhs_ptr.data()$RHS_BLOCK_CPARAM_TAIL);
  // The caller passes the index of the shared physical point: at spacing
  // dx/2^k that point is index sample_index*2^k, so the three grids sample the
  // same location and the Richardson ratio is meaningful.
  const unsigned sample = static_cast<unsigned>(sample_index);
  out.assign(ncomp, 0.0);
  for (unsigned f = 0; f < ncomp; ++f) {
    out[f] = static_cast<double>(
        rhs[f][sample + g.nx * (sample + g.ny * sample)]);
  }
}

double max_abs_difference(const std::vector<double>& a,
                          const std::vector<double>& b) {
  double worst = 0.0;
  for (std::size_t k = 0; k < a.size() && k < b.size(); ++k) {
    const double d = std::fabs(a[k] - b[k]);
    if (d > worst) worst = d;
  }
  return worst;
}

}  // namespace

double observed_convergence_order(
    double base_dx, double amplitude, double wavelength,
    const fccz4::generated::GeneratedParams& params) {
  const int pad = static_cast<int>(fccz4::generated::REQUIRED_PADDING);
  const int coarse = 2 * pad + 9;  // odd, so the centre is a grid point
  const int centre = (coarse - 1) / 2;
  std::vector<double> r_h;
  std::vector<double> r_h2;
  std::vector<double> r_h4;
  sample_rhs_at_centre(coarse, base_dx, centre, amplitude, wavelength, params,
                       r_h);
  sample_rhs_at_centre(2 * coarse - 1, base_dx / 2.0, 2 * centre, amplitude,
                       wavelength, params, r_h2);
  sample_rhs_at_centre(4 * coarse - 3, base_dx / 4.0, 4 * centre, amplitude,
                       wavelength, params, r_h4);
  const double d1 = max_abs_difference(r_h, r_h2);
  const double d2 = max_abs_difference(r_h2, r_h4);
  if (!(d1 > 0.0) || !(d2 > 0.0)) return -1.0;
  return std::log2(d1 / d2);
}

}  // namespace fccz4
