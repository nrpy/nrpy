int test_padding() {
  // The generated padding constants (section 8.6) are mutually consistent and
  // positive.  The padding itself is derived from the captured accesses at
  // generation time and cross-checked there against the operator stencils; it
  // is deliberately not re-derived here, which would be a second stencil model.
  if (fccz4::generated::REQUIRED_PADDING < 1) return 1;
  if (fccz4::generated::REQUIRED_PADDING_X != fccz4::generated::REQUIRED_PADDING)
    return 1;
  if (fccz4::generated::REQUIRED_PADDING_Y != fccz4::generated::REQUIRED_PADDING)
    return 1;
  if (fccz4::generated::REQUIRED_PADDING_Z != fccz4::generated::REQUIRED_PADDING)
    return 1;
  if (fccz4::generated::MINIMUM_ELEMENT_ORDER_UNDER_CURRENT_RULE !=
      2 * fccz4::generated::REQUIRED_PADDING) {
    return 1;
  }
  return 0;
}

int test_offsets() {
  // Section 8.2: the generated bindings add `geom.component_offset`, so a
  // writer aimed at component offset V must fill exactly the second block of a
  // two-block allocation and leave the first untouched.  This exercises the
  // emitted pointer arithmetic rather than restating it.
  TestBlock block(2);
  block.geom.component_offset = block.vol;
  std::vector<DendroScalar*> out = block.state_pointers();
  fccz4_minkowski_initial_data_block(block.geom, out.data());
  double first_block_norm = 0.0;
  double second_block_norm = 0.0;
  for (unsigned f = 0; f < NUM_EVOL_GFS; ++f) {
    for (std::size_t cell = 0; cell < block.vol; ++cell) {
      first_block_norm +=
          std::fabs(static_cast<double>(block.store[f][cell]));
      second_block_norm +=
          std::fabs(static_cast<double>(block.store[f][block.vol + cell]));
    }
  }
  if (first_block_norm != 0.0) return 1;   // wrote outside its component
  if (second_block_norm <= 0.0) return 1;  // wrote nothing at the offset
  return 0;
}

int test_upwind() {
  // Section 8.5: the generated kernel selects between the shifted stencils
  // using the registered upwind control fields, whose indices are generated
  // (no field is named here).  Flipping the sign of the control must change
  // the RHS: if it does not, the shifted stencils are not being selected.
  if (fccz4::generated::NUM_UPWIND_CONTROL_GFS == 0) return 0;
  fccz4::generated::GeneratedParams params;
  fccz4_params_set_defaults(params);

  double results[2][2] = {{0.0, 0.0}, {0.0, 0.0}};
  for (int sign_index = 0; sign_index < 2; ++sign_index) {
    const double sign = (sign_index == 0) ? 1.0 : -1.0;
    TestBlock block;
    std::vector<DendroScalar*> out = block.state_pointers();
    fccz4_minkowski_initial_data_block(block.geom, out.data());
    // A linear ramp along x makes every first derivative nonzero, and a
    // uniform control field selects one shifted stencil everywhere.
    for (unsigned f = 0; f < NUM_EVOL_GFS; ++f) {
      for (unsigned c = 0; c < block.extent; ++c) {
        for (unsigned b = 0; b < block.extent; ++b) {
          for (unsigned a = 0; a < block.extent; ++a) {
            block.store[f][block.index(a, b, c)] +=
                static_cast<DendroScalar>(1e-3 * static_cast<double>(a));
          }
        }
      }
    }
    for (unsigned k = 0; k < fccz4::generated::NUM_UPWIND_CONTROL_GFS; ++k) {
      const unsigned f = fccz4::generated::EVOL_UPWIND_CONTROL_INDICES[k];
      for (std::size_t cell = 0; cell < block.vol; ++cell) {
        block.store[f][cell] = static_cast<DendroScalar>(sign * 0.5);
      }
    }
    std::vector<const DendroScalar*> in = block.const_state_pointers();
    std::vector<DendroScalar*> rhs = block.rhs_pointers();
    fccz4_rhs_block(block.geom, in.data(), rhs.data()$RHS_BLOCK_CPARAM_TAIL);
    results[sign_index][0] = max_abs_interior(block);
    results[sign_index][1] =
        static_cast<double>(block.rhs[0][block.index(
            block.geom.padding, block.geom.padding, block.geom.padding)]);
  }
  if (results[0][0] <= 0.0 || results[1][0] <= 0.0) return 1;
  if (results[0][1] == results[1][1]) return 1;  // control had no effect
  return 0;
}

int test_rhs() {
  // The Minkowski state is a fixed point: the generated initial-data
  // CFunction (section 14.1) fills every EVOL field to its registered
  // asymptotic value and the generated direct-FD RHS must then vanish at
  // every interior cell.
  fccz4::generated::GeneratedParams params;
  fccz4_params_set_defaults(params);
  TestBlock block;
  std::vector<DendroScalar*> out = block.state_pointers();
  fccz4_minkowski_initial_data_block(block.geom, out.data());
  std::vector<const DendroScalar*> in = block.const_state_pointers();
  std::vector<DendroScalar*> rhs = block.rhs_pointers();
  fccz4_rhs_block(block.geom, in.data(), rhs.data()$RHS_BLOCK_CPARAM_TAIL);
  return max_abs_interior(block) <= 1e-13 ? 0 : 2;
}

int test_init() {
  // The generated Minkowski fill writes every EVOL field to its registered
  // asymptotic value at every cell: the result must be non-trivial (some
  // component is nonzero) and must match the generated metadata, so the
  // writer and the state registry agree without naming a field.
  TestBlock block;
  std::vector<DendroScalar*> out = block.state_pointers();
  fccz4_minkowski_initial_data_block(block.geom, out.data());
  double norm = 0.0;
  for (unsigned f = 0; f < NUM_EVOL_GFS; ++f) {
    for (std::size_t cell = 0; cell < block.vol; ++cell) {
      const double written = static_cast<double>(block.store[f][cell]);
      norm += std::fabs(written);
      if (std::fabs(written -
                    static_cast<double>(fccz4::generated::EVOL_GF_F_INFINITY[f])) >
          1e-15) {
        return 2;  // fill disagrees with the generated asymptotic metadata
      }
    }
  }
  if (norm <= 0.0) return 3;  // the fill wrote only zeros (not Minkowski)
  return 0;
}

