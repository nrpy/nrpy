int test_names() {
  // Section 14.7: every generated name resolves to its own group and index,
  // matching is case-sensitive, and an unknown name resolves to nothing.
  for (const fccz4::generated::VariableRef::Group group :
       fccz4::generated::VARIABLE_GROUPS) {
    const unsigned count = fccz4::generated::variable_count(group);
    for (unsigned index = 0; index < count; ++index) {
      const std::string_view name = fccz4::generated::variable_name(group, index);
      if (name.empty()) return 1;
      const std::optional<fccz4::generated::VariableRef> ref =
          fccz4::generated::find_variable(name);
      if (!ref.has_value()) return 2;
      if (ref->group != group || ref->index != index) return 3;
      // A case-flipped spelling must not resolve unless it is itself a
      // generated name: NRPy variance suffixes are case-sensitive.
      std::string flipped(name);
      bool changed = false;
      for (char& c : flipped) {
        if (c >= 'a' && c <= 'z') {
          c = static_cast<char>(c - 'a' + 'A');
          changed = true;
        } else if (c >= 'A' && c <= 'Z') {
          c = static_cast<char>(c - 'A' + 'a');
          changed = true;
        }  // END ELSE IF: uppercase letter flipped
      }  // END LOOP: for c over name characters
      if (changed && flipped != std::string(name)) {
        bool flipped_is_generated = false;
        for (const fccz4::generated::VariableRef::Group other :
             fccz4::generated::VARIABLE_GROUPS) {
          const unsigned n = fccz4::generated::variable_count(other);
          for (unsigned k = 0; k < n; ++k) {
            if (fccz4::generated::variable_name(other, k) == flipped) {
              flipped_is_generated = true;
            }  // END IF: flipped spelling is itself generated
          }  // END LOOP: for k over other group names
        }  // END LOOP: for other over generated groups
        const bool resolved =
            fccz4::generated::find_variable(flipped).has_value();
        if (resolved != flipped_is_generated) return 4;
      }  // END IF: case flip produced a different spelling
    }  // END LOOP: for index over group names
  }  // END LOOP: for group over generated groups
  if (fccz4::generated::find_variable("no_such_generated_variable")
          .has_value()) {
    return 5;
  }
  if (fccz4::generated::find_variable("").has_value()) return 6;
  return 0;
}  // END FUNCTION: test_names

int test_projection() {
  // Section 16.7: a flat state is unchanged, a perturbed state is projected
  // onto the determinant and trace constraints, and projection is idempotent.
  // The perturbation is applied through the generated CFunction to every
  // component, so no field is named and no asymptotic value is written here.
  TestBlock block;
  std::vector<DendroScalar*> state = block.state_pointers();
  fccz4_minkowski_initial_data_block(block.geom, state.data());
  std::vector<std::vector<DendroScalar>> flat = block.store;
  fccz4::generated::ProjectionStatus flat_status;
  fccz4_project_block(block.geom, state.data(), &flat_status);
  if (flat_status.failed_points != 0) return 1;
  if (block.store != flat) return 2;  // flat state must be untouched
  if (flat_status.max_abs_det_minus_one > 5e-13) return 3;
  if (flat_status.max_abs_trace_residual > 5e-13) return 4;

  fccz4_smooth_perturbation_block(block.geom, state.data(),
                                  static_cast<DendroScalar>(1e-2),
                                  static_cast<DendroScalar>(1.0));
  fccz4::generated::ProjectionStatus first;
  fccz4_project_block(block.geom, state.data(), &first);
  if (first.failed_points != 0) return 5;
  if (first.projected_points == 0) return 6;
  fccz4::generated::ProjectionStatus second;
  fccz4_project_block(block.geom, state.data(), &second);
  if (second.failed_points != 0) return 7;
  // After one projection the constraints hold to the section 16.7 tolerance.
  if (second.max_abs_det_minus_one > 5e-13) return 8;
  // Tolerance scale: max(1, largest |evolved component|) over the block.
  double state_scale = 1.0;
  for (unsigned f = 0; f < NUM_EVOL_GFS; ++f) {
    for (std::size_t cell = 0; cell < block.vol; ++cell) {
      state_scale = std::max(
          state_scale, std::fabs(static_cast<double>(block.store[f][cell])));
    }  // END LOOP: for cell over the block
  }  // END LOOP: for f over evolved components
  if (second.max_abs_trace_residual > 5e-13 * state_scale) return 9;
  // Idempotence to the section 16.7 tolerance: a further projection of an
  // already-projected state moves no value by more than the tolerance.
  // Bitwise equality is not the claim -- the projector recomputes a cube root
  // and an inverse, so the last ulp may move.
  std::vector<std::vector<DendroScalar>> projected = block.store;
  fccz4::generated::ProjectionStatus third;
  fccz4_project_block(block.geom, state.data(), &third);
  if (third.failed_points != 0) return 10;
  double moved = 0.0;
  for (unsigned f = 0; f < NUM_EVOL_GFS; ++f) {
    for (std::size_t cell = 0; cell < block.vol; ++cell) {
      moved = std::max(moved,
                       std::fabs(static_cast<double>(block.store[f][cell]) -
                                 static_cast<double>(projected[f][cell])));
    }  // END LOOP: for cell over the block
  }  // END LOOP: for f over evolved components
  if (moved > 5e-13 * state_scale) return 11;
  if (third.max_abs_det_minus_one > 5e-13) return 12;
  if (third.max_abs_trace_residual > 5e-13 * state_scale) return 13;
  return 0;
}  // END FUNCTION: test_projection

int test_constraints() {
  // Section 14.6: the constraint diagnostics of the Minkowski solution
  // vanish.  The reduction runs over the generated DIAG count, so no
  // diagnostic is named.  Pointwise diagnostic correctness is established by
  // the fixed-block equivalence oracle in the NRPy PR 9 exit test.
  if (fccz4::generated::NUM_DIAG_GFS == 0) return 1;
  TestBlock block;
  std::vector<DendroScalar*> state = block.state_pointers();
  fccz4_minkowski_initial_data_block(block.geom, state.data());
  DiagBlock diag(block.vol);
  std::vector<DendroScalar*> diag_ptr = diag.pointers();
  std::vector<const DendroScalar*> in = block.const_state_pointers();
  fccz4_constraints_block(block.geom, in.data(), diag_ptr.data());
  const unsigned pad = block.geom.padding;
  double worst = 0.0;
  for (unsigned f = 0; f < fccz4::generated::NUM_DIAG_GFS; ++f) {
    for (unsigned c = pad; c < block.extent - pad; ++c) {
      for (unsigned b = pad; b < block.extent - pad; ++b) {
        for (unsigned a = pad; a < block.extent - pad; ++a) {
          worst = std::max(worst,
                           std::fabs(static_cast<double>(
                               diag.store[f][block.index(a, b, c)])));
        }  // END LOOP: for a over interior
      }  // END LOOP: for b over interior
    }  // END LOOP: for c over interior
  }  // END LOOP: for f over diagnostic components
  return worst <= 1e-13 ? 0 : 2;
}  // END FUNCTION: test_constraints

int run_section(const char* section) {
  if (std::strcmp(section, "state") == 0) return test_state();
  if (std::strcmp(section, "params") == 0) return test_params();
  if (std::strcmp(section, "padding") == 0) return test_padding();
  if (std::strcmp(section, "offsets") == 0) return test_offsets();
  if (std::strcmp(section, "upwind") == 0) return test_upwind();
  if (std::strcmp(section, "rhs") == 0) return test_rhs();
  if (std::strcmp(section, "init") == 0) return test_init();
  if (std::strcmp(section, "names") == 0) return test_names();
  if (std::strcmp(section, "projection") == 0) return test_projection();
  if (std::strcmp(section, "constraints") == 0) return test_constraints();
  if (std::strcmp(section, "all") == 0) {
    const int rc = test_state() + test_params() + test_padding() +
                   test_offsets() + test_upwind() + test_rhs() + test_init() +
                   test_names() + test_projection() + test_constraints();
    return rc == 0 ? 0 : 1;
  }
  std::fprintf(stderr, "unknown section %s\n", section);
  return 2;
}

}  // namespace

int main(int argc, char* argv[]) {
  const char* section = (argc > 1) ? argv[1] : "all";
  const int rc = run_section(section);
  if (rc != 0) std::fprintf(stderr, "FAIL: section %s rc=%d\n", section, rc);
  return rc;
}
