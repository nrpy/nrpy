double max_abs_interior(const TestBlock& block) {
  double worst = 0.0;
  const unsigned pad = block.geom.padding;
  for (unsigned f = 0; f < NUM_EVOL_GFS; ++f) {
    for (unsigned c = pad; c < block.extent - pad; ++c) {
      for (unsigned b = pad; b < block.extent - pad; ++b) {
        for (unsigned a = pad; a < block.extent - pad; ++a) {
          worst = std::max(
              worst, std::fabs(static_cast<double>(
                         block.rhs[f][block.index(a, b, c)])));
        }
      }
    }
  }
  return worst;
}

int test_state() {
  // The generated state registry must be internally complete: one name per
  // enum member, all names distinct (a duplicate would alias two evolved
  // fields onto one identity), and one metadata entry per field (section 5.5).
  if (NUM_EVOL_GFS == 0) return 1;
  if (fccz4::generated::to_index(fccz4::generated::EvolVar::count) !=
      NUM_EVOL_GFS) {
    return 1;
  }
  if (fccz4::generated::EVOL_GF_NAMES.size() != NUM_EVOL_GFS) return 1;
  if (fccz4::generated::EVOL_GF_RANK.size() != NUM_EVOL_GFS) return 1;
  if (fccz4::generated::EVOL_GF_F_INFINITY.size() != NUM_EVOL_GFS) return 1;
  if (fccz4::generated::EVOL_GF_WAVESPEED.size() != NUM_EVOL_GFS) return 1;
  for (unsigned f = 0; f < NUM_EVOL_GFS; ++f) {
    if (fccz4::generated::EVOL_GF_NAMES[f].empty()) return 1;
    for (unsigned g = f + 1; g < NUM_EVOL_GFS; ++g) {
      if (fccz4::generated::EVOL_GF_NAMES[f] ==
          fccz4::generated::EVOL_GF_NAMES[g]) {
        return 1;
      }
    }
    if (!(fccz4::generated::EVOL_GF_WAVESPEED[f] > 0.0)) return 1;
  }
  if (std::strlen(fccz4::generated::STATE_SCHEMA_HASH) != 64) return 1;
  return 0;
}

